<section class="reading-frame">
  <header class="reading-heading">
    <h1><%= page.title %></h1>
    <% if (page.content.trim()) { %><div class="prose"><%- page.content %></div><% } %>
  </header>
  <div class="card-grid">
    <% page.links.forEach(link => { %>
      <a class="card" href="<%= url_for(link.href) %>">
        <h2><%= link.title %></h2>
        <% if (link.description) { %><p><%= link.description %></p><% } %>
      </a>
    <% }); %>
  </div>
</section>
