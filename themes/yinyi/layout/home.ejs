<section class="hero" aria-labelledby="home-title">
  <div class="hero-copy">
    <p class="eyebrow"><%= config.subtitle %></p>
    <h1 id="home-title"><%= config.title %></h1>
    <div class="hero-actions">
      <a class="button button--primary" href="<%= url_for('blog/') %>">读博客</a>
      <a class="button" href="<%= url_for('blog/projects/') %>">看项目</a>
      <a class="button" href="<%= url_for('archives/') %>">文章归档</a>
      <a class="button" href="<%= url_for('about/') %>">关于我</a>
    </div>
  </div>
  <div class="hero-art">
    <%- partial('_partial/image', { src: theme.images.hero, number: 'IMG-02', label: '首页主图', variant: 'hero' }) %>
  </div>
</section>
<% const latest = site.posts.sort('-date').findOne({}); %>
<% if (latest) { %>
  <section class="home-updates" aria-labelledby="updates-heading">
    <h2 id="updates-heading">最近发布</h2>
    <a href="<%= url_for(latest.path) %>"><%= latest.title %></a>
    <time datetime="<%= date(latest.date, 'YYYY-MM-DD') %>"><%= date(latest.date) %></time>
  </section>
<% } %>
