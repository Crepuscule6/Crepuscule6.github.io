<!doctype html>
<html lang="<%= config.language %>">
<% const home = page.path === 'index.html'; %>
<%
  const navigation = [
    { path: 'about/', label: '关于' },
    { path: 'blog/', label: 'Blog' },
    { path: 'services/', label: '服务' },
    { path: 'more/', label: '更多' },
    { path: 'friends/', label: '友链' },
  ];
  let parentSection = '';
  const morePages = ['status/index.html', 'gallery/index.html', 'devices/index.html'];
  if (is_archive() || morePages.includes(page.path)) parentSection = 'more/';
  else if (is_post() || is_category() || is_tag()) parentSection = 'blog/';
  const pageTitle = page.title || page.category || page.tag || (page.__index ? 'Blog' : is_archive() ? '文章归档' : '');
%>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="<%= config.description %>">
  <title><%= !home && pageTitle ? `${pageTitle} · ${config.title}` : config.title %></title>
  <% if (theme.images.logo) { %>
    <link rel="icon" href="<%= url_for(theme.images.logo) %>">
  <% } %>
  <link rel="stylesheet" href="<%= url_for('css/site.css') %>?v=20261116-more">
</head>
<body>
  <a class="skip-link" href="#content">跳到内容</a>
  <header class="site-header wrap">
    <a class="brand" href="<%= url_for('/') %>" aria-label="<%= config.title %>，回到首页">
      <%- partial('_partial/image', { src: theme.images.logo, number: 'IMG-01', label: '', variant: 'logo' }) %>
      <span><%= config.title %></span>
    </a>
    <nav class="top-nav" aria-label="主要导航">
      <% navigation.forEach(({ path, label }, index) => { %>
        <% const current = page.path === `${path}index.html` ? 'page' : parentSection === path ? 'true' : ''; %>
        <% if (index > 0) { %><span aria-hidden="true">·</span><% } %>
        <a href="<%= url_for(path) %>"<%- current ? ` aria-current="${current}"` : '' %>><%= label %></a>
      <% }); %>
    </nav>
  </header>
  <main class="wrap site-main" id="content" tabindex="-1"><%- body %></main>
</body>
</html>
